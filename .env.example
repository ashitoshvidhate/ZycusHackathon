LLM_PROVIDER=mock
LLM_BASE_URL=https://your-approved-gateway.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=your-approved-model
LLM_PRODUCT_HEADER=your-product-code
LLM_COOKIE= # Optional; keep this server-side and never commit a real session cookie.
DB_URL=jdbc:mysql://localhost:3306/stockpulse?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your-local-mysql-password
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OAUTH_ISSUER_URI=https://identity.example.com/realms/stockpulse
OAUTH_JWK_SET_URI=https://identity.example.com/realms/stockpulse/protocol/openid-connect/certs
OAUTH_AUDIENCE=stockpulse-api
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_OIDC_AUTHORITY=https://identity.example.com/realms/stockpulse
VITE_OIDC_CLIENT_ID=stockpulse-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_LOGOUT_REDIRECT_URI=http://localhost:5173
VITE_OIDC_SCOPE=openid profile stockpulse.read inventory.write suggestions.write suggestions.review strategy.admin
